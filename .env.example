# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DroidNest Deployment & Integration Configuration:
NEXT_PUBLIC_SITE_URL="https://droidnest.app"
VITE_SITE_URL="https://droidnest.app"

# Supabase PostgreSQL & Auth Credentials:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Analytics (Keep empty until real IDs are supplied):
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
VITE_GTM_ID=""
VITE_GA4_ID=""
